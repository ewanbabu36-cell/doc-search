# DocSearch Healthcare Platform - Production Docker Environment Variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=docsearch
DATABASE_URL=postgresql://postgres:replace_with_strong_password_in_production@postgres:5432/docsearch

# Redis
REDIS_URL=redis://redis:6379

# Authentication & Cryptography
JWT_SECRET=production_super_strong_cryptographic_key_min_32_characters
JWT_ISSUER=docsearch-api
JWT_AUDIENCE=docsearch-platform

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
