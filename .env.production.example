# ==============================================================================
# DocSearch Healthcare Enterprise Platform - Production Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.production on your production server:
#    cp .env.production.example .env.production
# 2. Populate strong, randomly-generated secrets for passwords and cryptographic keys.
# 3. Restrict file permissions: chmod 600 .env.production
# ==============================================================================

# Global Environment Mode
NODE_ENV=production
LOG_LEVEL=info

# Domain Names & Hostnames
PRIMARY_DOMAIN=docsearch.in
PARTNER_PORTAL_DOMAIN=partner.docsearch.in
PATIENT_APP_DOMAIN=patient.docsearch.in
COMPANY_HQ_DOMAIN=hq.docsearch.in
PACS_SERVER_DOMAIN=pacs.docsearch.in
API_GATEWAY_DOMAIN=api.docsearch.in

# ------------------------------------------------------------------------------
# 1. PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=docsearch_admin
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_64_CHAR_PASSWORD_A1b2C3d4!
POSTGRES_DB=docsearch
DATABASE_URL=postgresql://docsearch_admin:REPLACE_WITH_SECURE_64_CHAR_PASSWORD_A1b2C3d4!@postgres:5432/docsearch
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=50
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 2. Redis 7 High-Speed Session Cache & Rate Limiting
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=REPLACE_WITH_SECURE_32_CHAR_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Master Keys (AES-256-GCM & Ed25519)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_HEX_64_CHAR_MASTER_JWT_KEY_MIN_32_BYTES_REQUIRED
JWT_ISSUER=docsearch-api-gateway
JWT_AUDIENCE=docsearch-healthcare-network
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 64-character hexadecimal key for AES-256-GCM field-level encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. API Gateway Network Ports & Ingress
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=https://docsearch.in,https://partner.docsearch.in,https://patient.docsearch.in,https://hq.docsearch.in
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 5. Radiology PACS Server & DICOM Telemetry
# ------------------------------------------------------------------------------
PACS_DICOM_PORT=11112
PACS_HTTP_PORT=8042
PACS_AE_TITLE=DOCSEARCH_PACS
PACS_STORAGE_DIR=/app/data/pacs-storage

# ------------------------------------------------------------------------------
# 6. Disaster Recovery & Rolling Encrypted Backups
# ------------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=6
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_BACKUP_ENCRYPTION_SECRET
S3_BACKUP_ENABLED=false
S3_BUCKET_NAME=docsearch-disaster-recovery
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# ------------------------------------------------------------------------------
# 7. Let's Encrypt SSL/TLS Configuration
# ------------------------------------------------------------------------------
CERTBOT_EMAIL=admin@docsearch.in
STAGING_SSL=false
