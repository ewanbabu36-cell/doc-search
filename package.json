{
  "name": "doc-search",
  "version": "1.0.0",
  "private": true,
  "description": "Doc Search - Next-Gen Healthcare Platform Monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:all": "node scripts/start-all.js",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test --test-concurrency=1 packages/auth/test/*.test.mjs packages/database/test/*.test.mjs apps/api-gateway/test/*.test.mjs",
    "test:unit": "node --test packages/auth/test/*.test.mjs",
    "test:db": "node --test --test-concurrency=1 packages/database/test/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 apps/api-gateway/test/*.test.mjs",
    "test:security": "node tests/security/adversarial-security-audit.mjs && node tests/security/p0-production-security-audit.mjs",
    "test:production-certification": "node scripts/production-certification-runner.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  }
}
