# DOC SEARCH Environment Variables Template
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docsearch
DATABASE_SSL=false
# DATABASE_SSL_CA=/path/to/ca.pem

# Cryptographic Keys & JWT Configuration
# In production: JWT_SECRET must be >= 32 characters, ENCRYPTION_KEY must be 64-char hex
JWT_SECRET=docsearch_master_jwt_secret_dev_32char_key_only
JWT_ISSUER=docsearch-api
JWT_AUDIENCE=docsearch-platform
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Whitelist (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000
