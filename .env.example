# DOC SEARCH Environment Variables Template
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docsearch
DATABASE_SSL=false
# DATABASE_SSL_CA=/path/to/ca.pem
DATABASE_CONTEXT_SECRET=e7b4c91823d0614a523b1285f769024f8d910248c8942a78d0f1b2c3d4e5f607

# Cryptographic Keys & JWT Configuration
# In production: JWT_SECRET must be >= 32 characters, ENCRYPTION_KEY must be 64-char hex
JWT_SECRET=docsearch_master_jwt_secret_dev_32char_key_only
JWT_ISSUER=docsearch-api
JWT_AUDIENCE=docsearch-platform
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Whitelist (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# ==========================================
# Omnichannel Communication Integrations
# ==========================================
# 1. Gmail & Google Workspace (App Password)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_FROM="DocSearch Healthcare <your-email@gmail.com>"

# 2. Firebase Cloud Messaging (FCM) & Auth
FIREBASE_PROJECT_ID=docsearch-healthcare
FIREBASE_SERVER_KEY=your-firebase-server-key-or-fcm-token
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# 3. Telegram Healthcare Alert Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ADMIN_CHAT_ID=987654321

