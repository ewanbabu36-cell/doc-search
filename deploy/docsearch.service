[Unit]
Description=DocSearch Healthcare Enterprise Suite (9-Container Suite)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/docsearch
EnvironmentFile=-/opt/docsearch/.env.production

# Start stack on boot
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --remove-orphans

# Stop stack gracefully on system shutdown
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml down

# Hot-reload configuration without dropping active HTTP sessions
ExecReload=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml restart

Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
