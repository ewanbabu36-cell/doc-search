# ==============================================================================
# DocSearch Web Applications - Multi-Stage Build with NGINX Alpine
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Web Bundle
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

ARG APP_NAME=partner-platform

WORKDIR /app

RUN apk add --no-cache libc6-compat

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @docsearch/shared-core build && \
    pnpm --filter @docsearch/api-contracts build && \
    pnpm --filter @docsearch/ui-kit build && \
    pnpm --filter @docsearch/${APP_NAME} build

# ------------------------------------------------------------------------------
# Stage 2: Production NGINX Static Server
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runner

ARG APP_NAME=partner-platform

# Remove default nginx static assets and configs
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/*

# Copy custom NGINX configurations
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy compiled SPA bundle from builder
COPY --from=builder /app/apps/${APP_NAME}/dist/bundle /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
