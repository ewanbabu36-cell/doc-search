# ==============================================================================
# DocSearch Production NGINX Ingress Reverse Proxy with TLS 1.2/1.3 Hardening
# ==============================================================================
FROM nginx:1.27-alpine

RUN apk add --no-cache curl openssl

# Remove default nginx configurations
RUN rm -rf /etc/nginx/conf.d/* /etc/nginx/nginx.conf

# Prepare SSL and ACME challenge directories
RUN mkdir -p /etc/nginx/ssl /var/www/certbot

# Generate default self-signed fallback certificates for zero-crash startup
RUN openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/privkey.pem \
    -out /etc/nginx/ssl/fullchain.pem \
    -subj "/C=IN/ST=Maharashtra/L=Mumbai/O=DocSearch/CN=docsearch.local" \
    && chmod 600 /etc/nginx/ssl/privkey.pem

# Copy production master ingress configuration
COPY docker/nginx/nginx-production-ingress.conf /etc/nginx/nginx.conf

EXPOSE 80 443

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
