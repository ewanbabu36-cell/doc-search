# ==============================================================================
# DocSearch API Gateway - Production Multi-Stage Dockerfile
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Dependencies & Source Code
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache libc6-compat python3 make g++

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy root manifest and workspace package manifests for cached dependency installation
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/shared-core/package.json ./packages/shared-core/
COPY packages/database/package.json ./packages/database/
COPY packages/api-contracts/package.json ./packages/api-contracts/
COPY packages/auth/package.json ./packages/auth/
COPY packages/ui-kit/package.json ./packages/ui-kit/
COPY apps/api-gateway/package.json ./apps/api-gateway/

RUN pnpm install --frozen-lockfile

# Copy full source trees
COPY packages/ ./packages/
COPY apps/api-gateway/ ./apps/api-gateway/

# Build shared libraries and API Gateway
RUN pnpm --filter @docsearch/shared-core build && \
    pnpm --filter @docsearch/database build && \
    pnpm --filter @docsearch/api-contracts build && \
    pnpm --filter @docsearch/auth build && \
    pnpm --filter @docsearch/api-gateway build

# Prune dev dependencies for lean production container
RUN pnpm prune --prod

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

RUN apk add --no-cache dumb-init curl

# Create unprivileged application user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 docsearch && \
    chown -R docsearch:nodejs /app

USER docsearch

# Copy package structures and built artifacts
COPY --from=builder --chown=docsearch:nodejs /app/package.json ./package.json
COPY --from=builder --chown=docsearch:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=docsearch:nodejs /app/packages ./packages
COPY --from=builder --chown=docsearch:nodejs /app/apps/api-gateway/package.json ./apps/api-gateway/package.json
COPY --from=builder --chown=docsearch:nodejs /app/apps/api-gateway/dist ./apps/api-gateway/dist
COPY --from=builder --chown=docsearch:nodejs /app/apps/api-gateway/node_modules ./apps/api-gateway/node_modules

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/api-gateway/dist/server.js"]
