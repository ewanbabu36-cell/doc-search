default_platform(:ios)

platform :ios do
  desc "Build signed App Store IPA for Aarogya360"
  lane :release do
    increment_build_number(xcodeproj: "App/App.xcodeproj")
    cocoapods(podfile: "App/Podfile")
    build_app(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: "App/ExportOptions.plist",
      output_directory: "../dist/ipa",
      output_name: "aarogya360-patient-v1.0.0.ipa"
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
